"This form was already submitted. Reload it to send a different request."
msgstr ""
"Este formulario ya fue enviado. Recargalo para enviar una solicitud "
"diferente."

#: includes/class-requests.php:72
msgid "Too many requests. Please wait ten minutes and try again."
msgstr "Demasiadas solicitudes. Esperá diez minutos y reintentá."

#: includes/class-requests.php:90
msgid "The request could not be saved. Please try again."
msgstr "No se pudo guardar la solicitud. Reintentá."

#: includes/class-requests.php:99
msgid "All requests"
msgstr "Todas las solicitudes"

#: includes/class-requests.php:100
msgid "Without an offer"
msgstr "Sin oferta"

