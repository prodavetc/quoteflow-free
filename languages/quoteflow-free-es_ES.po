msgstr "No se encontró la solicitud."

#: includes/class-requests.php:173
msgid "The offer is being prepared. Please try again."
msgstr "Se está preparando la oferta. Reintentá."

#: includes/class-requests.php:185
msgid ""
"The store security keys changed. The original private link is required."
msgstr ""
"Cambiaron las claves de seguridad de la tienda. Se requiere el enlace "
