msgid "Request a quote"
msgstr "Solicitar cotización"

#: includes/class-request-form.php:97
msgid "Your request was received. The store will contact you with an offer."
msgstr ""
"Recibimos tu solicitud. La tienda se pondrá en contacto con vos con una "
"oferta."

#: includes/class-request-form.php:122
msgid "Billing email"
msgstr "Correo de facturación"

#: includes/class-request-form.php:124
msgid "What do you need?"
msgstr "¿Qué necesitás?"

#: includes/class-request-form.php:126
msgid "Leave this field empty"
msgstr "Dejá este campo vacío"

