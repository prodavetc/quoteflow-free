#: includes/class-taxes.php:125
msgid "The accepted shipping taxes changed."
msgstr "Cambiaron los impuestos de envío aceptados."

#: includes/class-taxes.php:134
msgid "Duplicate tax lines need review."
msgstr "Las líneas de impuestos duplicadas requieren revisión."

#: includes/class-taxes.php:143
msgid "The accepted order totals changed. Contact the store before paying."
msgstr ""
"Cambiaron los totales aceptados del pedido. Contactá con la tienda antes de "
"pagar."

