#!/bin/sh
# Production changes are promoted through a pull request on GitHub.
while read -r local_ref local_oid remote_ref remote_oid; do
    if [ "$remote_ref" = "refs/heads/main" ]; then
        echo "Push directo a main bloqueado. Subí los cambios a dev y abrí un pull request hacia main." >&2
        exit 1
    fi
done
exit 0
